            "url": {
              "raw": "{{baseUrl}}{{prefixoBff}}/actuator/health/readiness",
              "host": [
                "{{baseUrl}}{{prefixoBff}}/actuator/health/readiness"
              ]
            },
            "description": "O que a sonda do Kubernetes consulta. UP quando o contexto subiu.",
            "auth": {
              "type": "noauth"
            }
          },
          "response": []
