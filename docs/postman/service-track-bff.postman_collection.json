    {
      "name": "Ordens de serviço",
      "description": "Abertura, consulta e aprovacao de orcamento. A aprovacao **nao** transiciona o estado por si: ela dispara a saga de reserva de insumo, e quem avanca a OS e a confirmacao da saga (`GLOBAL-ADR-007`).",
      "item": [
        {
          "name": "Abrir ordem",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "x-api-key",
                "value": "{{apiKey}}",
                "description": "Exigida pelo API Gateway em hml e prd. Vazia no local, onde nao ha gateway."
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}{{prefixoBff}}/ordens",
              "host": [
                "{{baseUrl}}{{prefixoBff}}/ordens"
              ]
            },
            "description": "Abre a OS. Os tres identificadores sao UUID e precisam existir nos servicos donos. O teste guarda o id devolvido em `ordemId`.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"motivo\": \"{{motivo}}\",\n  \"clienteId\": \"{{clienteId}}\",\n  \"mecanicoId\": \"{{mecanicoId}}\",\n  \"veiculoId\": \"{{veiculoId}}\",\n  \"observacao\": \"\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"responde 201\", () => pm.response.to.have.status(201));",
                  "const corpo = pm.response.json();",
                  "if (corpo.id) { pm.environment.set(\"ordemId\", corpo.id); }"
                ]
              }
            }
          ]
        },
